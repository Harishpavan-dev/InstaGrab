# Application
NODE_ENV=production
PORT=3000

# File Management
FILE_EXPIRATION_MINUTES=30
MAX_DOWNLOAD_SIZE_MB=500
TEMP_DIR=./temp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DOWNLOAD_RATE_LIMIT_MAX=10
INFO_RATE_LIMIT_MAX=30

# CORS
ALLOWED_ORIGINS=https://yourdomain.com

# Loggin
LOG_LEVEL=info
