# Application
NODE_ENV=production
PORT=3000

# File Management
FILE_EXPIRATION_MINUTES=30
MAX_DOWNLOAD_SIZE_MB=500
TEMP_DIR=./temp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DOWNLOAD_RATE_LIMIT_MAX=10
INFO_RATE_LIMIT_MAX=30

# CORS
ALLOWED_ORIGINS=https://yourdomain.com

# Logging
LOG_LEVEL=info

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=instagrab
DB_PASSWORD=your_db_password
DB_NAME=instagrab_db

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
ADMIN_JWT_SECRET=your_jwt_secret_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_ENABLED=false
TELEGRAM_MAX_FILE_SIZE_MB=50
TELEGRAM_WELCOME_MSG="👋 Hey {{name}}! Welcome to InstaGrab Bot!\n\n📥 Send me an Instagram reel or post link."
